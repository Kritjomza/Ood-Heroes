{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Odd Tower Phase 4 Asset Manifest",
  "type": "object",
  "required": ["schemaVersion", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "category",
          "entityName",
          "usage",
          "priority",
          "currentState",
          "mockImplementation",
          "targetFilePath",
          "fileFormat",
          "width",
          "height",
          "transparentBackground",
          "cameraAngle",
          "requiredDirections",
          "frameCount",
          "anchorX",
          "anchorY",
          "atlasGroup",
          "mobileReadabilityNotes",
          "styleNotes",
          "promptSubjectNotes",
          "negativeRequirements",
          "replacementInstructions"
        ],
        "properties": {
          "assetId": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "entityName": { "type": ["string", "null"] },
          "usage": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "priority": { "enum": ["P0", "P1", "P2"] },
          "currentState": { "enum": ["mock", "missing", "final"] },
          "mockImplementation": { "type": "string" },
          "targetFilePath": { "type": "string" },
          "fileFormat": { "enum": ["png", "webp", "svg", "json"] },
          "width": { "type": ["integer", "null"], "minimum": 1 },
          "height": { "type": ["integer", "null"], "minimum": 1 },
          "transparentBackground": { "type": "boolean" },
          "cameraAngle": { "type": ["string", "null"] },
          "requiredDirections": { "type": "array", "items": { "type": "string" } },
          "frameCount": { "type": "integer", "minimum": 1 },
          "anchorX": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "anchorY": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "atlasGroup": { "type": ["string", "null"] },
          "mobileReadabilityNotes": { "type": "string" },
          "styleNotes": { "type": "string" },
          "promptSubjectNotes": { "type": "string" },
          "negativeRequirements": { "type": "array", "items": { "type": "string" } },
          "replacementInstructions": { "type": "string" }
        }
      }
    }
  }
}
