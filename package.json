{
  "name": "odd-tower",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --config apps/client/vite.config.ts",
    "dev:server": "npm run dev -w @odd-tower/game-server",
    "build": "npm run build:server && npm run build:client",
    "build:client": "tsc -b packages/game-core packages/network-protocol apps/client && vite build --config apps/client/vite.config.ts",
    "build:server": "tsc -b packages/game-core packages/network-protocol apps/game-server",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:multiplayer": "vitest run packages/network-protocol apps/game-server apps/client/tests/prediction.test.ts apps/client/tests/interpolation.test.ts apps/client/tests/MultiplayerBridge.test.ts apps/client/tests/MultiplayerClient.test.ts apps/client/tests/OnlineUi.test.tsx && playwright test tests/e2e/multiplayer.spec.ts --project=chromium",
    "test:load": "tsx --conditions=development tests/load/ten-player-room.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "phaser": "3.90.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@colyseus/testing": "0.17.11",
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/cors": "2.8.19",
    "@types/debug": "4.1.13",
    "@types/express": "5.0.6",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "3.2.4",
    "concurrently": "10.0.4",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
