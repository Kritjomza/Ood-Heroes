PORT=2567
CLIENT_ORIGIN=http://127.0.0.1:4173
VITE_APP_BASE_URL=http://127.0.0.1:4173
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-local-supabase-anon-or-publishable-key
VITE_GAME_SERVER_URL=ws://127.0.0.1:2567
VITE_GAME_SERVER_HTTP_URL=http://127.0.0.1:2567
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-local-supabase-anon-or-publishable-key
SUPABASE_SECRET_KEY=your-local-server-only-secret-key

# New persistent world rollout (disabled by default on both server and client).
MMO_WORLD_ENABLED=0
MMO_WORLD_ACCOUNT_IDS=comma-separated-supabase-user-ids
VITE_MMO_WORLD_ENABLED=0

# Google OAuth is configured in Google Cloud and Supabase Auth.
# Do not expose the Google Client Secret to Vite or browser code.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
MMO_WORLD_ENABLED=0
MMO_WORLD_ACCOUNT_IDS=
# Rollout stages: internal | alpha | beta | all (server-side operator control)
MMO_WORLD_ROLLOUT_STAGE=internal
